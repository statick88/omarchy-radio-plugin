{
  "schemaVersion": 1,
  "id": "statick.radio",
  "name": "Radio",
  "version": "1.0.0",
  "author": "statick",
  "license": "MIT",
  "description": "Beautiful radio plugin for Omarchy with 3+ preset stations and easy configuration",
  "kinds": [
    "bar-widget",
    "overlay"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml",
    "overlay": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Radio",
    "description": "Listen to radio stations with easy configuration",
    "category": "Audio",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "station": 1,
      "volume": 80
    },
    "schema": [
      {
        "key": "station",
        "type": "integer",
        "label": "Current Station",
        "defaultValue": 1,
        "min": 1,
        "max": 20,
        "step": 1
      },
      {
        "key": "volume",
        "type": "integer",
        "label": "Volume (%)",
        "defaultValue": 80,
        "min": 0,
        "max": 100,
        "step": 5
      }
    ]
  }
}